---
// src/pages/adhesion.astro
import BaseLayout from '../../layouts/BaseLayout.astro';

// Chemins des fichiers du bulletin d'adhésion
const bulletinPdf = "/uploads/fichierInscription.pdf";
const bulletinDoc = "/uploads/fichierInscription.doc";
---

<BaseLayout 
  title="Adhésion au Club Autostar" 
  description="Rejoignez le Club Autostar : découvrez les conditions d'adhésion, les avantages membres et téléchargez le bulletin d'inscription."
>
  <!-- Hero Banner Adhésion -->
  <div class="bg-slate-900 text-white p-8 md:p-12 rounded-xl mb-10 shadow-lg">
    <div class="max-w-3xl">
      <span class="inline-block bg-red-700 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider mb-3">
        Rejoignez-nous !
      </span>
      <h1 class="text-3xl md:text-5xl font-extrabold mb-3">Adhésion au Club Autostar</h1>
      <p class="text-slate-300 text-sm md:text-base leading-relaxed">
        Vous êtes propriétaire d'un camping-car AUTOSTAR ? Venez partager vos voyages, échanger vos expériences et profiter de tous nos rassemblements et fiches techniques.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
    
    <!-- Zone Principale : Offres, Avantages & Téléchargements -->
    <div class="lg:col-span-2 space-y-8">
      
      <!-- Conditions d'Adhésion -->
      <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b-2 border-red-700 flex items-center gap-2">
          <span>💳</span> Modalités d'Adhésion
        </h2>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          
          <!-- Carte 1ère Inscription Offerte -->
          <div class="border-2 border-emerald-500 bg-emerald-50/50 rounded-xl p-6 relative flex flex-col justify-between">
            <span class="absolute -top-3 right-4 bg-emerald-600 text-white text-[10px] font-bold px-2.5 py-1 rounded-full uppercase">
              Cadeau de bienvenue
            </span>
            <div>
              <h3 class="font-extrabold text-slate-900 text-lg mb-2">1ère Inscription Gratuite</h3>
              <p class="text-xs text-emerald-800 font-semibold mb-3">Véhicule Neuf ou d'Occasion</p>
              <p class="text-xs text-slate-700 leading-relaxed mb-4">
                Pour tout premier achat d'un camping-car <strong>AUTOSTAR, qu'il soit neuf ou d'occasion</strong>, votre première inscription au club vous est gracieusement offerte !
              </p>
            </div>
            <a href="#bulletin" class="block text-center bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold py-2.5 px-4 rounded-lg transition-colors mt-auto">
              Télécharger le bulletin
            </a>
          </div>

          <!-- Carte Adhésion Classique & Renouvellement -->
          <div class="border border-slate-200 bg-slate-50 rounded-xl p-6 flex flex-col justify-between">
            <div>
              <h3 class="font-extrabold text-slate-900 text-lg mb-2">Cotisation Annuelle</h3>
              <p class="text-xs text-slate-500 font-semibold mb-3">Renouvellement & Réadhésion</p>
              <p class="text-xs text-slate-700 leading-relaxed mb-4">
                L'adhésion couvre l'année civile pour tout l'équipage. Elle vous donne accès à l'ensemble des activités, rassemblements, parutions et fiches techniques du club.
              </p>
              <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 mb-4 text-xs text-amber-900">
                ℹ️ <strong>Tarif :</strong> Le montant exact de la cotisation annuelle est indiqué directement sur le bulletin d'adhésion.
              </div>
            </div>
            <a href="#bulletin" class="block text-center bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold py-2.5 px-4 rounded-lg transition-colors mt-auto">
              Consulter le bulletin
            </a>
          </div>

        </div>
      </section>

      <!-- Section Téléchargement du Bulletin (PDF & DOC) -->
      <section id="bulletin" class="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-2 pb-2 border-b-2 border-red-700 flex items-center gap-2">
          <span>📝</span> Fiche d'Adhésion à Télécharger
        </h2>
        <p class="text-xs md:text-sm text-slate-600 mb-6">
          Choisissez le format qui vous convient pour compléter votre demande d'inscription et prendre connaissance des détails tarifaires :
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Format PDF -->
          <div class="border border-red-200 bg-red-50/50 rounded-xl p-5 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl">📄</span>
              <div>
                <h3 class="font-bold text-slate-900 text-sm">Version PDF imprimable</h3>
                <p class="text-xs text-slate-600 mt-1">Idéal pour imprimer et compléter le document à la main.</p>
              </div>
            </div>
            <a 
              href={bulletinPdf} 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-red-700 hover:bg-red-800 text-white text-xs font-bold py-2.5 px-4 rounded-lg transition-colors"
            >
              📥 Télécharger en PDF
            </a>
          </div>

          <!-- Format Word (DOC) -->
          <div class="border border-blue-200 bg-blue-50/50 rounded-xl p-5 flex flex-col justify-between hover:shadow-md transition-shadow">
            <div class="flex items-start gap-3 mb-4">
              <span class="text-3xl">📝</span>
              <div>
                <h3 class="font-bold text-slate-900 text-sm">Version Word (.doc)</h3>
                <p class="text-xs text-slate-600 mt-1">Idéal pour remplir le formulaire directement sur ordinateur.</p>
              </div>
            </div>
            <a 
              href={bulletinDoc} 
              download
              class="w-full inline-flex items-center justify-center gap-2 bg-blue-700 hover:bg-blue-800 text-white text-xs font-bold py-2.5 px-4 rounded-lg transition-colors"
            >
              📥 Télécharger en Word (.doc)
            </a>
          </div>
        </div>
      </section>

      <!-- Liste des Avantages Adhérents -->
      <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b-2 border-red-700 flex items-center gap-2">
          <span>🎁</span> Vos Avantages Membres
        </h2>

        <div class="space-y-4">
          <div class="flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-100">
            <span class="text-2xl p-2 bg-red-100 rounded-lg shrink-0">🚌</span>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Participation aux Sorties et Circuits</h3>
              <p class="text-xs text-slate-600 mt-1">
                Accédez en priorité à tous les voyages, rencontres régionales et rassemblements nationaux organisés par le bureau à des tarifs négociés.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-100">
            <span class="text-2xl p-2 bg-red-100 rounded-lg shrink-0">🛠️</span>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Accès aux Fiches "C'est pas sorcier"</h3>
              <p class="text-xs text-slate-600 mt-1">
                Consultez et téléchargez les guides d'entretien, conseils d'équipement et astuces de bricolage rédigés spécialement par les membres.
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-100">
            <span class="text-2xl p-2 bg-red-100 rounded-lg shrink-0">🇫🇷</span>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Affiliation à la FFACCC</h3>
              <p class="text-xs text-slate-600 mt-1">
                Bénéficiez de la carte de membre FFACCC, ouvrant droit à des réductions auprès de partenaires (assurances, revues spécialisées, guides d'étapes).
              </p>
            </div>
          </div>

          <div class="flex items-start gap-4 p-4 rounded-lg bg-slate-50 border border-slate-100">
            <span class="text-2xl p-2 bg-red-100 rounded-lg shrink-0">📰</span>
            <div>
              <h3 class="font-bold text-slate-900 text-base">Journal du Club & Trombinoscope</h3>
              <p class="text-xs text-slate-600 mt-1">
                Recevez les parutions du club et restez en contact permanent avec le réseau des passionnés d'Autostar.
              </p>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- Sidebar : Instructions d'envoi -->
    <div class="space-y-6">
      
      <!-- Bloc Modalités d'envoi -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200 space-y-4">
        <h3 class="font-bold text-slate-900 text-base border-b pb-2">📮 Comment envoyer votre dossier ?</h3>
        
        <ol class="text-xs text-slate-600 space-y-3 list-decimal pl-4">
          <li>Téléchargez le bulletin (au format <strong>PDF</strong> ou <strong>Word</strong>).</li>
          <li>Complétez lisiblement les informations concernant votre équipage et votre véhicule.</li>
          <li>Prenez connaissance du montant de la cotisation indiqué sur le bulletin et joignez votre règlement par chèque à l'ordre du <strong>Club Autostar</strong> (sauf 1ère adhésion offerte pour achat d'un véhicule neuf ou occasion avec justificatif).</li>
          <li>Envoyez le dossier complet à l'adresse du siège ci-dessous.</li>
        </ol>

        <div class="bg-slate-50 p-4 rounded-lg border border-slate-200 text-xs mt-4">
          <p class="font-bold text-slate-800 mb-1">Adresse d'expédition :</p>
          <p class="text-slate-600"><strong>Club Autostar</strong></p>
          <p class="text-slate-600">Secrétariat des Adhésions</p>
          <p class="text-slate-600">Z.I. du Launay</p>
          <p class="text-slate-600">22800 Saint-Brandan</p>
        </div>
      </div>

      <!-- Bloc Besoin d'aide -->
      <div class="bg-slate-100 p-6 rounded-xl border border-slate-200 text-center">
        <h4 class="font-bold text-slate-900 text-sm mb-1">Une question sur l'adhésion ?</h4>
        <p class="text-xs text-slate-600 mb-4">Notre secrétariat est à votre disposition pour vous renseigner.</p>
        <a href="/contact" class="inline-block bg-slate-800 hover:bg-slate-700 text-white text-xs font-semibold px-4 py-2 rounded-md transition-colors">
          Nous contacter
        </a>
      </div>

    </div>

  </div>
</BaseLayout>