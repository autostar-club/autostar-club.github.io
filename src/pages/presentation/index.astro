---
// src/pages/presentation.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Organigramme from './Organigramme.astro';

---

<BaseLayout 
  title="Présentation du Club" 
  description="Découvrez l'histoire, les valeurs, les objectifs et l'organigramme du Club Autostar."
>
  <!-- Hero Banner Présentation -->
  <div class="relative bg-slate-900 text-white p-8 md:p-12 rounded-xl mb-10 overflow-hidden shadow-lg">
    <div class="relative z-10 max-w-3xl">
      <!-- Badge avec mention des 40 ans -->
      <div class="flex flex-wrap gap-2 mb-3">
        <span class="inline-block bg-red-700 text-white text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider">
          Association loi 1901 — Depuis 1987
        </span>
        <span class="inline-block bg-amber-500/90 text-slate-950 text-xs font-extrabold px-3 py-1 rounded-full uppercase tracking-wider">
          🎂 Le club va avoir 40 ans en 2027 !
        </span>
      </div>

      <h1 class="text-3xl md:text-5xl font-extrabold leading-tight mb-4">
        Le Club Autostar
      </h1>
      <p class="text-lg md:text-xl text-slate-300 italic font-serif mb-6">
        « Toujours libres, jamais seuls »
      </p>
      <p class="text-sm md:text-base text-slate-300 leading-relaxed">
        Une communauté de passionnés et d'utilisateurs de camping-cars AUTOSTAR réunie autour des valeurs de convivialité, d'entraide et du plaisir de voyager ensemble.
      </p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
    
    <!-- Colonne Principale -->
    <div class="lg:col-span-2 space-y-10">
      
      <!-- Section Histoire -->
      <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-4 pb-2 border-b-2 border-red-700 flex items-center gap-2">
          <span>📜</span> Notre Histoire
        </h2>
        <div class="prose prose-slate max-w-none text-slate-700 space-y-4 text-sm md:text-base leading-relaxed">
          <p>
            L'<strong>AUTOSTAR-CLUB</strong> a été créé en 1987 sous l'impulsion des dirigeants de la société AUTOSTAR et de passionnés de la marque. 
            Le but initial était d'offrir aux propriétaires d'un véhicule de la marque un espace d'échange où confronter leurs expériences et former un véritable club d'amis.
          </p>
          <p>
            Fort de cette belle longévité, <strong>le Club Autostar va fêter ses 40 ans en 2027 !</strong> Depuis près de quatre décennies, il regroupe plusieurs centaines d'équipages répartis dans toute la France. Être Autostariste, c'est bénéficier d'un réseau dynamique d'entraide et participer à des rassemblements chaleureux tout au long de l'année.
          </p>
          <div class="bg-slate-50 border-l-4 border-red-700 p-4 rounded-r-lg my-4 text-sm font-medium text-slate-800">
            🎁 <strong>Offre aux Propriétaires d’un CC AUTOSTAR, neuf ou d’occasion :</strong> En cadeau de bienvenue, la 1ère inscription au club AUTOSTAR est offerte !
          </div>
        </div>
      </section>

      <!-- Section Nos Objectifs -->
      <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-6 pb-2 border-b-2 border-red-700 flex items-center gap-2">
          <span>🎯</span> Les Objectifs du Club
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-2xl mb-2">🤝</div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Entraide & Convivialité</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Permettre une meilleure pratique du camping-car dans un esprit d'échange d'expériences entre anciens et nouveaux camping-caristes.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-2xl mb-2">🗺️</div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Sorties & Voyages</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Bénéficier d'un programme annuel de rassemblements et circuits en France ou à l'étranger, parfaitement organisés et sécurisés.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-2xl mb-2">🛠️</div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Fiches "C'est pas sorcier"</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Recevoir des parutions et fiches techniques rédigées par des membres bricoleurs pour entretenir et améliorer votre véhicule.
            </p>
          </div>

          <div class="p-4 bg-slate-50 rounded-lg border border-slate-100">
            <div class="text-2xl mb-2">🛡️</div>
            <h3 class="font-bold text-slate-900 text-base mb-1">Défense des Intérêts</h3>
            <p class="text-xs text-slate-600 leading-relaxed">
              Représenter les adhérents et préserver leurs droits de pratique du camping-car grâce à notre affiliation à la FFACCC.
            </p>
          </div>
        </div>
      </section>



<!-- Section Bureau & Organigramme -->
      <section class="bg-white p-6 md:p-8 rounded-xl shadow-sm border border-slate-200">
        <h2 class="text-2xl font-bold text-slate-900 mb-2 pb-2 border-b-2 border-red-700 flex items-center gap-2">
          <span>👥</span> Le Bureau et le Conseil d'Administration (2026)
        </h2>
        <p class="text-sm text-slate-600 mb-6">
          Le Club Autostar est administré par des bénévoles élus en Assemblée Générale et assisté de délégués régionaux.
        </p>

        <!-- Composant des cartes individuelles modifiables via Decap CMS -->
        <Organigramme />

        <!-- 🖼️ Bloc Organigramme Complet (Affiche Officielle) -->
        <div class="mt-10 pt-6 border-t border-slate-200">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
            <div>
              <h3 class="text-base font-bold text-slate-900">Affiche officielle de l'organigramme 2026</h3>
              <p class="text-xs text-slate-500">Document officiel au format portrait</p>
            </div>
            <a 
              href="/uploads/ORGANIGRAMME-2026-PORTRAIT_0.jpg" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-1.5 text-xs font-semibold bg-red-700 hover:bg-red-800 text-white px-3.5 py-2 rounded-lg transition-colors shadow-sm self-start sm:self-auto"
            >
              🔍 Ouvrir en haute résolution
            </a>
          </div>

          <!-- Cadre de prévisualisation cliquable -->
          <div class="bg-slate-50 border border-slate-200 rounded-xl p-3 text-center overflow-hidden group">
            <a 
              href="/uploads/ORGANIGRAMME-2026-PORTRAIT_0.jpg" 
              target="_blank" 
              rel="noopener noreferrer"
              class="block relative overflow-hidden rounded-lg cursor-zoom-in"
              title="Cliquez pour agrandir l'organigramme"
            >
              <img 
                src="/uploads/ORGANIGRAMME-2026-PORTRAIT_0.jpg" 
                alt="Organigramme officiel Autostar Club 2026" 
                class="max-h-[520px] w-auto mx-auto object-contain rounded-lg shadow-sm group-hover:scale-[1.01] transition-transform duration-300"
              />
              <!-- Effet de survol -->
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/10 transition-colors flex items-center justify-center">
                <span class="opacity-0 group-hover:opacity-100 bg-slate-900/80 text-white text-xs font-semibold px-4 py-2 rounded-full transition-opacity shadow-lg">
                  🔍 Cliquez pour agrandir en plein écran
                </span>
              </div>
            </a>
          </div>
        </div>
      </section>

    </div>

    <!-- Sidebar Latérale -->
    <div class="space-y-6">
      
      <!-- Bloc Adhésion Rapide -->
      <div class="bg-red-700 text-white p-6 rounded-xl shadow-md">
        <h3 class="text-xl font-bold mb-2">Rejoignez le Club !</h3>
        <p class="text-xs text-red-100 mb-4 leading-relaxed">
          Vous possédez un camping-car AUTOSTAR ? Venez partager vos voyages et profiter des avantages réservés aux adhérents.
        </p>
        <a 
          href="/adhesion" 
          class="block text-center w-full bg-white text-red-700 hover:bg-red-50 font-bold text-sm py-2.5 px-4 rounded-lg transition-colors shadow-sm"
        >
          Découvrir les tarifs & adhésion
        </a>
      </div>

      <!-- Bloc Affiliation FFACCC -->
      <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-200">
        <div class="flex items-center gap-3 mb-3">
          <img 
            src="/ffaacc.webp" 
            alt="Logo FFACCC" 
            class="h-8 w-auto rounded object-contain bg-white p-0.5 border border-slate-100 shadow-sm"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
          />
          <span class="text-3xl hidden">🇫🇷</span>
          <div>
            <h4 class="font-bold text-slate-900 text-sm">Club Affilié FFACCC</h4>
            <p class="text-xs text-slate-500">Fédération Française des Associations et Clubs de Camping-Cars</p>
          </div>
        </div>

        <p class="text-xs text-slate-600 mb-4 leading-relaxed">
          En adhérant au Club Autostar, vous bénéficiez également des services et avantages accordés par la FFACCC (carte de membre, assurances, revues spécialisées, possibilité de participer à leurs sorties).
        </p>

        <!-- Coordonnées et contacts FFACCC -->
        <div class="pt-3 mb-4 border-t border-slate-100 text-xs text-slate-600 space-y-2">
          <div class="font-semibold text-slate-800 text-[11px] uppercase tracking-wider">Contact FFACCC</div>
          
          <!-- Téléphone -->
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <a href="tel:+33800800158" class="hover:text-red-700 transition-colors">
              +33 800 80 01 58
            </a>
          </div>

          <!-- Email -->
          <div class="flex items-center gap-2">
            <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:contact@ffaccc.info" class="hover:text-red-700 transition-colors">
              contact@ffaccc.info
            </a>
          </div>

          <!-- Référence Site -->
          <div class="flex items-center gap-2 text-slate-500">
            <svg class="w-3.5 h-3.5 text-slate-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/>
            </svg>
            <span>Site : <strong class="font-medium text-slate-700">uccf-ffaccc</strong></span>
          </div>
        </div>

        <!-- Lien vers le site -->
        <a 
          href="https://www.ffaccc.info" 
          target="_blank" 
          rel="noopener noreferrer"
          class="text-xs font-semibold text-red-700 hover:underline flex items-center gap-1"
        >
          En savoir plus sur la FFACCC ↗
        </a>
      </div>

      <!-- Bloc Coordonnées du Siège -->
      <div class="bg-slate-50 p-6 rounded-xl border border-slate-200 text-xs space-y-3">
        <h4 class="font-bold text-slate-900 text-sm border-b pb-2">Siège Social & Contact</h4>
        <p class="text-slate-600"><strong>Club Autostar</strong></p>
        <p class="text-slate-600">ZI du Launay, 22800 Saint-Brandan</p>
        <p class="text-slate-600">📞 Téléphone : 02 96 79 60 35</p>
        <p class="text-slate-600">✉️ Email : autostar.club@orange.fr</p>
      </div>

    </div>

  </div>
</BaseLayout>