---
// src/pages/fiches-pratiques/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const fiches = await getCollection('fiches');
  return fiches.map((entry) => ({
    params: { slug:  entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, category, date, author, pdfFile, description } = entry.data;

// Couleurs de badge selon la catégorie
const categoryColors: Record<string, string> = {
  Électricité: 'bg-amber-100 text-amber-800 border-amber-300',
  Plomberie: 'bg-blue-100 text-blue-800 border-blue-300',
  Entretien: 'bg-emerald-100 text-emerald-800 border-emerald-300',
  Accessoires: 'bg-purple-100 text-purple-800 border-purple-300',
  Default: 'bg-slate-100 text-slate-800 border-slate-300',
};

const badgeClass = categoryColors[category] || categoryColors.Default;
---

<BaseLayout title={title} description={description}>
  <!-- Bouton Retour -->
  <div class="mb-6">
    <a href="/fiches-pratiques" class="inline-flex items-center text-sm font-semibold text-slate-600 hover:text-red-700 transition-colors">
      ← Retour aux fiches pratiques
    </a>
  </div>

  <article class="max-w-4xl mx-auto bg-white rounded-xl shadow-sm border border-slate-200 overflow-hidden">
    <!-- En-tête Fiche -->
    <div class="p-6 md:p-8 bg-slate-900 text-white">
      <div class="flex items-center gap-3 mb-3">
        <span class={`text-xs font-semibold px-3 py-1 rounded-full border ${badgeClass}`}>
          {category}
        </span>
        {date && <span class="text-xs text-slate-400">Publié le {date}</span>}
      </div>

      <h1 class="text-2xl md:text-4xl font-extrabold mb-3">{title}</h1>
      
      {author && (
        <p class="text-xs text-slate-400 italic">
          Rédigé par : <span class="text-slate-200 font-medium">{author}</span>
        </p>
      )}
    </div>

    <!-- Contenu principal -->
    <div class="p-6 md:p-10">
      <!-- Bloc téléchargement PDF si disponible -->
      {pdfFile && (
        <div class="mb-8 p-4 bg-red-50 border border-red-200 rounded-lg flex flex-col sm:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-3">
            <span class="text-2xl">📄</span>
            <div>
              <h4 class="font-bold text-red-900 text-sm">Fiche technique téléchargeable</h4>
              <p class="text-xs text-red-700">Vous pouvez imprimer ou télécharger ce document au format PDF.</p>
            </div>
          </div>
          <a
            href={pdfFile}
            target="_blank"
            rel="noopener noreferrer"
            class="shrink-0 bg-red-700 hover:bg-red-800 text-white font-semibold text-xs py-2 px-4 rounded-md transition-colors inline-flex items-center gap-1.5"
          >
            Télécharger le PDF
          </a>
        </div>
      )}

      <!-- Contenu Markdown du tutoriel -->
      <div class="prose prose-slate max-w-none">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>