---
// src/components/home/LatestEvents.astro
import { getCollection } from 'astro:content';
import SortieCard from '../sorties/SortieCard.astro';

interface Props {
  limit?: number;
}

const { limit = 3 } = Astro.props;

// Récupération des sorties depuis Astro Content Collections
let sorties = [];
try {
  const allSorties = await getCollection('sorties');
  // Filtre les sorties "à venir" et trie par date
  sorties = allSorties
    .filter((s:any) => s.data.status === 'a-venir')
    .sort((a:any, b:any) => new Date(a.data.startDate).getTime() - new Date(b.data.startDate).getTime())
    .slice(0, limit);
} catch (e) {
  // Fallback si la collection n'est pas encore initialisée
  sorties = [];
}
---

<section class="my-12">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-8 pb-3 border-b border-slate-200">
    <div>
      <span class="text-xs font-bold text-red-700 tracking-wider uppercase">Agenda du club</span>
      <h2 class="text-2xl font-extrabold text-slate-900 mt-1">Prochaines Sorties & Rassemblements</h2>
    </div>
    <a 
      href="/sorties/a-venir" 
      class="mt-3 sm:mt-0 text-sm font-semibold text-red-700 hover:text-red-800 flex items-center gap-1"
    >
      Voir tout le programme 
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
      </svg>
    </a>
  </div>

  {sorties.length > 0 ? (
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {sorties.map((sortie:any) => (
        <SortieCard
          title={sortie.data.title}
          date={sortie.data.dateFormatted}
          location={sortie.data.location}
          slug={sortie.slug}
          image={sortie.data.image}
          organizers={sortie.data.organizers}
        />
      ))}
    </div>
  ) : (
    <div class="bg-slate-50 border border-dashed border-slate-300 rounded-lg p-8 text-center text-slate-600">
      <p class="font-medium">Aucune nouvelle sortie programmée pour le moment.</p>
      <p class="text-sm text-slate-500 mt-1">Revenez très bientôt ou consultez les <a href="/sorties/ecoulees" class="text-red-700 underline">sorties écoulées</a> pour voir nos précédents circuits.</p>
    </div>
  )}
</section>